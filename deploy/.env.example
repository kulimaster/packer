# Zkopíruj na .env a uprav. .env NIKDY necommituj.
# Tohle je jen pro lokální vývoj (deploy/compose.dev.yaml).
# Prostředí pro produkci na VPS je deploy/quadlet/packer.env.example.
POSTGRES_USER=packer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=packer

# Connection string pro API (lokálně jde přes dotnet user-secrets, viz deploy/README.md)
# Host=localhost;Port=5442;Database=packer;Username=packer;Password=change-me
