# syntax=docker/dockerfile:1

# Produkční image webu: statický build z Vite + Caddy, který ho servíruje
# a proxyuje /api na kontejner s API. Žádný Node v runtime.
#
# Build context je kořen repa (viz deploy/compose.yaml a CI).
#
# `npm run build` = `tsc -b && vite build`, takže typová chyba build zastaví –
# do produkce se nedostane něco, co neprošlo typecheckem.

ARG NODE_VERSION=24
ARG CADDY_VERSION=2

# --- 1) build frontendu ---
FROM node:${NODE_VERSION}-alpine AS build
WORKDIR /web

# Nejdřív lockfile: změna kódu nezahodí cache instalace.
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci

COPY apps/web ./
RUN npm run build

# --- 2) runtime ---
FROM caddy:${CADDY_VERSION}-alpine AS runtime

# Caddyfile je součástí image – konfigurace se mění commitem, ne na serveru.
COPY deploy/Caddyfile /etc/caddy/Caddyfile

# Statický build. Vlastní ho uživatel caddy z image, Caddy ho jen čte.
COPY --from=build /web/dist /srv

EXPOSE 80 443 443/udp
