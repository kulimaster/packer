# Prostředí pro Quadlet units na serveru.
#
# Zkopíruj na ~/.config/containers/systemd/packer.env, uprav a nastav chmod 600.
# Tento soubor NIKDY necommituj – obsahuje heslo k databázi.
#
# Formát: KEY=value, jedna hodnota na řádek. Hodnoty se neinterpolují
# (žádné ${...}), takže heslo musí být na obou místech stejné.

POSTGRES_USER=packer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=packer

# Musí odpovídat POSTGRES_* výše. Host je jméno kontejneru v síti packer.
ConnectionStrings__Default=Host=packer-db;Port=5432;Database=packer;Username=packer;Password=change-me

# Doména, na kterou Caddy vystaví TLS. Musí mít A/AAAA záznam na VPS.
PACKER_DOMAIN=packer.example.com
PACKER_ACME_EMAIL=you@example.com
