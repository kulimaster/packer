<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Api: HTTP vrstva. Endpointy, DI, middleware, OpenAPI.
    Žádná business logika - ta patří do Application.
  -->
  <PropertyGroup>
    <UserSecretsId>packer-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Potřebné pro `dotnet ef` – nástroje hledají Design v startup projektu. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Packer.Domain\Packer.Domain.csproj" />
    <ProjectReference Include="..\Packer.Application\Packer.Application.csproj" />
    <ProjectReference Include="..\Packer.Infrastructure\Packer.Infrastructure.csproj" />
  </ItemGroup>

</Project>
